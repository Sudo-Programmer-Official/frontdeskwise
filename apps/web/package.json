{
  "name": "frontdeskwise-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-widget.mjs && node scripts/generate-site-metadata.mjs",
