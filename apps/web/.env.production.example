# Public API origin exposed to the browser.
VITE_API_ORIGIN=https://api.frontdeskwise.com
# Used at build time for robots.txt and sitemap.xml.
VITE_SITE_ORIGIN=https://www.frontdeskwise.com
# Firebase Web App configuration. These values are public client settings,
# but must use the same Firebase project as FIREBASE_PROJECT_ID on Render.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
# Use the Firebase-provisioned domain unless auth.frontdeskwise.com has a
# Connected status and valid certificate in Firebase. The password-reset email
# template must point to the deployed /auth/reset-password action handler.
VITE_FIREBASE_AUTH_DOMAIN=frontdeskwise-7846c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
