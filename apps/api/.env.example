PORT=8787
HOST=127.0.0.1
# Set this only for the new FrontDeskWise database. Never reuse ApplyPilot credentials.
# Use the sibling dev RDS host/role with the database path changed to /frontdeskwise.
DATABASE_URL=postgresql://user:password@host:5432/frontdeskwise?sslmode=require
FRONTDESKWISE_DATABASE_NAME=frontdeskwise
# Set true only when an RDS CA bundle is available in the runtime.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# For production certificate validation, provide the trusted RDS CA as a PEM file,
# PEM value, or base64 PEM. Render should use a Secret File plus this path:
# DATABASE_SSL_CA_FILE=/etc/secrets/rds-ca.pem
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_BASE64=
# Generate a unique 32-byte key for this environment. It encrypts CRM tokens at rest.
# Never commit the real value or reuse it across environments.
FRONTDESKWISE_CREDENTIAL_KEY=replace-with-a-32-byte-random-secret
# Optional when the web app is hosted separately from the API.
WEB_ORIGIN=http://localhost:5174
# Public URLs used by the owner install snippet. Override for staging/production.
FRONTDESKWISE_PUBLIC_API_ORIGIN=http://localhost:8787
FRONTDESKWISE_WIDGET_ORIGIN=http://localhost:5173
# Set true only when the deployed edge/proxy strips and rewrites forwarded headers.
FRONTDESKWISE_TRUST_PROXY=false
# Release correlation is included in API logs and durable observability. CI/CD
# should set the immutable commit SHA and deployment identifier at deploy time.
# FRONTDESKWISE_RELEASE_VERSION=local
# FRONTDESKWISE_DEPLOYMENT_VERSION=
# FRONTDESKWISE_MODEL_ROUTING_VERSION=model-routing-v1
# HubSpot Projects OAuth app credentials. Keep the client secret server-only.
# The generated HubSpot project should register this callback URL.
# FRONTDESKWISE_HUBSPOT_CLIENT_ID=
# FRONTDESKWISE_HUBSPOT_CLIENT_SECRET=
# FRONTDESKWISE_HUBSPOT_REDIRECT_URI=http://localhost:8787/api/v1/integrations/hubspot/callback
# FRONTDESKWISE_HUBSPOT_API_VERSION=2026-09
# FRONTDESKWISE_HUBSPOT_OAUTH_VERSION=2026-03
# FRONTDESKWISE_HUBSPOT_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write
# Optional app origin used in lifecycle-message CTA links.
# FRONTDESKWISE_APP_URL=http://localhost:5173
# Optional Web Push delivery for installed owner/staff operator devices.
# Generate one VAPID keypair per environment and keep the private key server-only.
# FRONTDESKWISE_WEB_PUSH_PUBLIC_KEY=
# FRONTDESKWISE_WEB_PUSH_PRIVATE_KEY=
# FRONTDESKWISE_WEB_PUSH_SUBJECT=mailto:support@frontdeskwise.com
# Optional support destination used in transactional billing emails.
# FRONTDESKWISE_SUPPORT_URL=https://www.frontdeskwise.com/support
# Firebase project used for email/password or Google sign-in. The API verifies
# ID tokens server-side; do not put a Firebase private key in this file.
# FIREBASE_PROJECT_ID=
# CRM delivery uses the FRONTDESKWISE_CREDENTIAL_KEY above; inject it through the
# staging/production secret manager and never reuse it across environments.
# Optional embedding worker configuration. Leave unset for PostgreSQL full-text retrieval only.
# OPENAI_API_KEY=
# FRONTDESKWISE_EMBEDDING_MODEL=text-embedding-3-small
# Optional answer-generation routing. Retrieval and extractive fallback work without these values.
# FRONTDESKWISE_LLM_ENABLED=true
# Capability names are stable application policy; model IDs stay configurable.
# Fast is for high-volume runtime work. Balanced is for harder grounded synthesis.
# Reasoning is reserved for workflow/Business Brain generation and repair.
# FRONTDESKWISE_MODEL_FAST=gpt-4o-mini
# FRONTDESKWISE_MODEL_BALANCED=gpt-4o
# FRONTDESKWISE_MODEL_REASONING=gpt-4o
# Legacy tier names remain supported while environments migrate.
# FRONTDESKWISE_LLM_MODEL_TIER1=gpt-4o-mini
# FRONTDESKWISE_LLM_MODEL_TIER2=gpt-4o
# FRONTDESKWISE_LLM_TIMEOUT_MS=8000
# FRONTDESKWISE_LLM_MAX_OUTPUT_TOKENS=280
# Optional usage accounting rates, in USD per one million tokens.
# FRONTDESKWISE_MODEL_FAST_INPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_MODEL_FAST_OUTPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_MODEL_BALANCED_INPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_MODEL_BALANCED_OUTPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_MODEL_REASONING_INPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_MODEL_REASONING_OUTPUT_COST_PER_MILLION_USD=
# Legacy cost variable names remain supported while environments migrate.
# FRONTDESKWISE_LLM_TIER1_INPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_LLM_TIER1_OUTPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_LLM_TIER2_INPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_LLM_TIER2_OUTPUT_COST_PER_MILLION_USD=
# Reserved for a future voice/translation channel; the website widget does not
# call realtime audio models yet.
# FRONTDESKWISE_REALTIME_AUDIO_MODEL=
# FRONTDESKWISE_REALTIME_TRANSCRIPTION_MODEL=
# FRONTDESKWISE_REALTIME_TRANSLATION_MODEL=
# API guardrails. Production values are also defined in .env.production.example.
FRONTDESKWISE_RATE_LIMIT_MAX=120
FRONTDESKWISE_RATE_LIMIT_WINDOW_MS=60000
FRONTDESKWISE_DEMO_RATE_LIMIT_MAX=10
FRONTDESKWISE_DEMO_RATE_LIMIT_WINDOW_MS=3600000
# Widget abuse controls are process-local defaults; use an edge/WAF or shared
# limiter for horizontally scaled production deployments.
FRONTDESKWISE_WIDGET_MESSAGE_RATE_LIMIT_MAX=30
FRONTDESKWISE_WIDGET_ACTION_RATE_LIMIT_MAX=12
FRONTDESKWISE_PROMPT_INJECTION_RATE_LIMIT_MAX=5
# Stripe is optional until live plans are connected. Keep all Stripe values server-side.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_GROWTH_MONTHLY=
# STRIPE_PRICE_MULTI_BUSINESS_MONTHLY=
# STRIPE_PRICE_PORTFOLIO_MONTHLY=
# Optional annual prices. Leave unset until annual checkout is enabled in Stripe.
# STRIPE_PRICE_STARTER_YEARLY=
# STRIPE_PRICE_GROWTH_YEARLY=
# STRIPE_PRICE_MULTI_BUSINESS_YEARLY=
# STRIPE_PRICE_PORTFOLIO_YEARLY=
# FRONTDESKWISE_STRIPE_SUCCESS_URL=http://localhost:5173/?billing=success
# FRONTDESKWISE_STRIPE_CANCEL_URL=http://localhost:5173/?billing=cancel
# FRONTDESKWISE_STRIPE_PORTAL_RETURN_URL=http://localhost:5173/?billing=portal
FRONTDESKWISE_DEFAULT_TRIAL_DAYS=7
# FRONTDESKWISE_SUPER_ADMIN_EMAILS=you@example.com
# AWS SDK uses the default credential chain. In Render, use a least-privilege IAM
# identity with access only to this app's private bucket and SES send actions.
# AWS_REGION=us-east-1
# FRONTDESKWISE_S3_BUCKET=frontdeskwise-documents-development
# FRONTDESKWISE_MAX_DOCUMENT_BYTES=26214400
# FRONTDESKWISE_SES_FROM_EMAIL=hello@frontdeskwise.com
# FRONTDESKWISE_SES_FROM_NAME=FrontDeskWise
# FRONTDESKWISE_SES_REPLY_TO=hello@frontdeskwise.com
# Optional shared secret for normalized SES delivery-event webhooks.
# FRONTDESKWISE_EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-secret
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
