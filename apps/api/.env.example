API_TITLE=FrontDeskWise API
ENV=development
PORT=8787
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5174

# Use a new FrontDeskWise database. Never point this at ApplyPilot's database.
DATABASE_URL=postgresql://user:password@host:5432/frontdeskwise
DATABASE_NAME=frontdeskwise

# Add these only when the ingestion/agent service is connected.
OPENAI_API_KEY=
S3_BUCKET=
AWS_REGION=us-east-1

