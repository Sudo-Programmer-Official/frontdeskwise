NODE_ENV=staging
HOST=0.0.0.0
# Render supplies PORT; keep this for local staging-like runs.
PORT=8787
# Point this at the separate FrontDeskWise database on the existing RDS instance.
DATABASE_URL=postgresql://staging_user:staging_password@staging-rds-host:5432/frontdeskwise?sslmode=require
FRONTDESKWISE_DATABASE_NAME=frontdeskwise
# Set false only while the RDS CA bundle is not mounted in the runtime.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Generate a unique 32-byte value for staging. Never reuse development or production values.
FRONTDESKWISE_CREDENTIAL_KEY=replace-with-a-unique-32-byte-staging-secret
WEB_ORIGIN=https://frontdeskwise-staging.vercel.app
FRONTDESKWISE_PUBLIC_API_ORIGIN=https://frontdeskwise-api-staging.onrender.com
FRONTDESKWISE_WIDGET_ORIGIN=https://frontdeskwise-staging.vercel.app
FRONTDESKWISE_WIDGET_URL=https://frontdeskwise-staging.vercel.app/widget.js
OPENAI_API_KEY=replace-with-staging-openai-key
FRONTDESKWISE_EMBEDDING_MODEL=text-embedding-3-small
