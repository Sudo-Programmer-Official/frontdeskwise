NODE_ENV=production
HOST=0.0.0.0
# Render supplies PORT.
PORT=8787
# Use a dedicated production database and role. Do not reuse staging or sibling-service credentials.
DATABASE_URL=postgresql://production_user:production_password@production-rds-host:5432/frontdeskwise?sslmode=require
FRONTDESKWISE_DATABASE_NAME=frontdeskwise
# Validate the RDS certificate in production. On Render, upload the PEM bundle
# as a Secret File named rds-ca.pem and point the app to it by path. This avoids
# putting a large certificate bundle into the process environment.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_FILE=/etc/secrets/rds-ca.pem
# Local alternative: DATABASE_SSL_CA_BASE64=replace-with-base64-rds-ca-pem
FRONTDESKWISE_CREDENTIAL_KEY=replace-with-a-unique-32-byte-production-secret
WEB_ORIGIN=https://frontdeskwise.com,https://www.frontdeskwise.com
FRONTDESKWISE_PUBLIC_API_ORIGIN=https://api.frontdeskwise.com
FRONTDESKWISE_WIDGET_ORIGIN=https://frontdeskwise.com
FRONTDESKWISE_WIDGET_URL=https://frontdeskwise.com/widget.js
# Firebase project ID shared with the web app. Firebase client config is public;
# the API only needs this project identifier to verify ID tokens.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
OPENAI_API_KEY=replace-with-production-openai-key
FRONTDESKWISE_EMBEDDING_MODEL=text-embedding-3-small
FRONTDESKWISE_RATE_LIMIT_MAX=120
FRONTDESKWISE_RATE_LIMIT_WINDOW_MS=60000
FRONTDESKWISE_DEMO_RATE_LIMIT_MAX=10
FRONTDESKWISE_DEMO_RATE_LIMIT_WINDOW_MS=3600000
