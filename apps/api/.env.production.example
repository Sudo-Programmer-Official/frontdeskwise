NODE_ENV=production
HOST=0.0.0.0
# Render supplies PORT.
PORT=8787
# Use a dedicated production database and role. Do not reuse staging or sibling-service credentials.
DATABASE_URL=postgresql://production_user:production_password@production-rds-host:5432/frontdeskwise?sslmode=require
FRONTDESKWISE_DATABASE_NAME=frontdeskwise
# Validate the RDS certificate in production. On Render, upload the PEM bundle
# as a Secret File named rds-ca.pem and point the app to it by path. This avoids
# putting a large certificate bundle into the process environment.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_FILE=/etc/secrets/rds-ca.pem
# Local alternative: DATABASE_SSL_CA_BASE64=replace-with-base64-rds-ca-pem
FRONTDESKWISE_CREDENTIAL_KEY=replace-with-a-unique-32-byte-production-secret
WEB_ORIGIN=https://frontdeskwise.com,https://www.frontdeskwise.com,https://app.frontdeskwise.com
FRONTDESKWISE_PUBLIC_API_ORIGIN=https://api.frontdeskwise.com
FRONTDESKWISE_WIDGET_ORIGIN=https://www.frontdeskwise.com
FRONTDESKWISE_WIDGET_URL=https://www.frontdeskwise.com/widget.js
FRONTDESKWISE_APP_URL=https://app.frontdeskwise.com
# HubSpot Projects OAuth app credentials. Keep the client secret in Render secrets.
FRONTDESKWISE_HUBSPOT_CLIENT_ID=replace-with-hubspot-project-client-id
FRONTDESKWISE_HUBSPOT_CLIENT_SECRET=replace-with-hubspot-project-client-secret
FRONTDESKWISE_HUBSPOT_REDIRECT_URI=https://api.frontdeskwise.com/api/v1/integrations/hubspot/callback
FRONTDESKWISE_HUBSPOT_API_VERSION=2026-09
FRONTDESKWISE_HUBSPOT_OAUTH_VERSION=2026-03
FRONTDESKWISE_HUBSPOT_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write
# Jackrabbit Customer API. The base URL is app-managed. The token is an
# optional local/certification fallback; normal SaaS connections come from
# Settings → Integrations and are stored encrypted per business.
FRONTDESKWISE_JACKRABBIT_API_TOKEN=
FRONTDESKWISE_JACKRABBIT_API_BASE_URL=https://sandbox-api.jackrabbitclass.com
# FRONTDESKWISE_JACKRABBIT_ALLOW_ENV_FALLBACK=true
# Firebase project ID shared with the web app. Firebase client config is public;
# the API only needs this project identifier to verify ID tokens.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
OPENAI_API_KEY=replace-with-production-openai-key
FRONTDESKWISE_EMBEDDING_MODEL=text-embedding-3-small
FRONTDESKWISE_LLM_ENABLED=true
FRONTDESKWISE_LLM_MODEL_TIER1=gpt-4o-mini
FRONTDESKWISE_LLM_MODEL_TIER2=gpt-4o
FRONTDESKWISE_LLM_TIMEOUT_MS=8000
FRONTDESKWISE_LLM_MAX_OUTPUT_TOKENS=280
# Optional usage accounting rates, in USD per one million tokens.
# FRONTDESKWISE_LLM_TIER1_INPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_LLM_TIER1_OUTPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_LLM_TIER2_INPUT_COST_PER_MILLION_USD=
# FRONTDESKWISE_LLM_TIER2_OUTPUT_COST_PER_MILLION_USD=
FRONTDESKWISE_RATE_LIMIT_MAX=120
FRONTDESKWISE_RATE_LIMIT_WINDOW_MS=60000
FRONTDESKWISE_DEMO_RATE_LIMIT_MAX=10
FRONTDESKWISE_DEMO_RATE_LIMIT_WINDOW_MS=3600000
# Stripe secret and webhook signing secret are server-only Render environment variables.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
STRIPE_PRICE_STARTER_MONTHLY=price_replace_me
STRIPE_PRICE_GROWTH_MONTHLY=price_replace_me
STRIPE_PRICE_MULTI_BUSINESS_MONTHLY=price_replace_me
STRIPE_PRICE_PORTFOLIO_MONTHLY=price_replace_me
# Optional annual prices. Leave as placeholders until annual checkout is enabled in Stripe.
STRIPE_PRICE_STARTER_YEARLY=price_replace_me
STRIPE_PRICE_GROWTH_YEARLY=price_replace_me
STRIPE_PRICE_MULTI_BUSINESS_YEARLY=price_replace_me
STRIPE_PRICE_PORTFOLIO_YEARLY=price_replace_me
FRONTDESKWISE_STRIPE_SUCCESS_URL=https://www.frontdeskwise.com/?billing=success
FRONTDESKWISE_STRIPE_CANCEL_URL=https://www.frontdeskwise.com/?billing=cancel
FRONTDESKWISE_STRIPE_PORTAL_RETURN_URL=https://www.frontdeskwise.com/?billing=portal
FRONTDESKWISE_SUPPORT_URL=https://www.frontdeskwise.com/support
FRONTDESKWISE_DEFAULT_TRIAL_DAYS=7
# Optional bootstrap allowlist. The verified Firebase user is inserted into super_admin_users on first admin request.
FRONTDESKWISE_SUPER_ADMIN_EMAILS=owner@example.com
# Private organization document storage. Keep the bucket non-public and use the
# default AWS credential chain from Render environment variables or an attached role.
AWS_REGION=us-east-1
FRONTDESKWISE_S3_BUCKET=frontdeskwise-documents-production
FRONTDESKWISE_MAX_DOCUMENT_BYTES=26214400
FRONTDESKWISE_SES_FROM_EMAIL=hello@frontdeskwise.com
FRONTDESKWISE_SES_FROM_NAME=FrontDeskWise
FRONTDESKWISE_SES_REPLY_TO=hello@frontdeskwise.com
FRONTDESKWISE_EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-production-secret
AWS_ACCESS_KEY_ID=replace-with-least-privilege-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-least-privilege-aws-secret-key
