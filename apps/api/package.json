{
  "name": "frontdeskwise-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "action-registry:certify": "node --import tsx src/action-registry-certify.ts",
    "jackrabbit:certify": "node --import tsx src/jackrabbit-certify.ts",
    "reference:certify": "node --import tsx src/reference-certification.ts",
    "retrieval:certify": "node --import tsx src/retrieval-certification.ts",
    "action-routing:certify": "node --import tsx src/action-routing-certification.ts",
    "certification:pyramid": "node --import tsx src/certification-pyramid.ts",
    "benchmark:cross-site": "node --import tsx src/cross-site-benchmark.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-sesv2": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^6.0.3",
    "mammoth": "^1.9.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "playwright": "^1.65.1",
    "stripe": "^23.2.0",
    "web-push": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
